<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#626B91</item>
        <item name="android:colorControlHighlight">#33626B91</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#293044</item>
        <item name="android:windowBackground">#F7F8FC</item>
        <item name="android:windowAnimationStyle">@style/FocusWindowAnimation</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="FocusWindowAnimation" parent="android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_return</item>
        <item name="android:activityCloseExitAnimation">@anim/page_leave</item>
    </style>
</resources>
